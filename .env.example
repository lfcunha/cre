# Copy to .env (gitignored) and fill in real values.

# https://data.cityofnewyork.us/profile/app_tokens
# Preferred: Socrata "API Key" pair, used via HTTP Basic Auth.
SOCRATA_KEY_ID=
SOCRATA_KEY_SECRET=

# Legacy fallback: a single "App Token" string, sent via the X-App-Token header.
# Only used if SOCRATA_KEY_ID/SOCRATA_KEY_SECRET aren't set.
SOCRATA_APP_TOKEN=

# S3 bucket the raw pulls get converted to Parquet and synced into.
# AWS credentials themselves come from the standard boto3 chain (env vars,
# ~/.aws/credentials, AWS_PROFILE, etc) -- not stored here.
S3_LAKE_BUCKET=
